# Backend Integration Configuration
# Rename this file to .env and place it in the root of the frontend repository
# Do not commit the actual .env file to version control

# This URL should point to your FastAPI server's base API route
# For Web Dev: http://localhost:8000/api/v1
# For Android Emulator Dev: http://10.0.2.2:8000/api/v1
# For Physical Android Device Dev: http://<YOUR_LOCAL_WIFI_IP>:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
